# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build
/dist

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (ignore all except .env.example)
.env
.env.local
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
.venv
__pycache__/

# uploads (legacy location)
/public/uploads/

# uploads (secure location - outside public/)
/uploads/

# generated certificates
/public/certificates/

# Sentry
.env.sentry-build-plugin
.sentryclirc

# test coverage
/coverage/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# logs
logs/
*.log

# prisma
prisma/*.db
prisma/*.db-journal
