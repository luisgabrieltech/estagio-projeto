# Use a mesma senha em POSTGRES_PASSWORD e DATABASE_URL.
# Gere a senha com: openssl rand -hex 24
POSTGRES_USER=avalia_local
POSTGRES_DB=avalia_dev
POSTGRES_PASSWORD=
DATABASE_URL="postgresql://avalia_local:SENHA_GERADA@127.0.0.1:5432/avalia_dev"

# Gere o segredo com: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_PATH=
LOG_LEVEL=info

# Opcional. Ative apenas em um banco de desenvolvimento ou demonstração.
DEMO_SEED_PASSWORD=

# SMTP opcional. Descomente e configure antes de usar.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Telemetria opcional. Configure apenas um projeto Sentry próprio.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Identidade pública opcional. Coloque o logotipo em public/ e use seu caminho público.
# NEXT_PUBLIC_BRAND_NAME=Avalia
# NEXT_PUBLIC_BRAND_LOGO_PATH=/images/meu-logo.png
# NEXT_PUBLIC_SUPPORT_EMAIL=
